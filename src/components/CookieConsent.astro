<div id="cookie-banner" class="cookie-banner" role="region" aria-labelledby="cookie-banner-title" hidden>
  <h2 id="cookie-banner-title">Your privacy choices</h2>
  <p>
    We'd like to use Google Analytics to see how people use this site. It only runs if you allow it. Necessary
    storage, such as remembering this choice, is always on. You can change your mind at any time with "Your privacy
    choices" in the footer. We don't use advertising cookies or sell personal information.{' '}
    <a href="/legal/privacy-policy/#6-analytics-cookies-and-similar-technologies">Privacy Policy</a>.
  </p>
  <div class="cookie-actions">
    <button type="button" id="cookie-accept" class="btn btn-primary btn-sm">Allow analytics</button>
    <button type="button" id="cookie-reject" class="btn btn-on-ink btn-sm">Don't allow analytics</button>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'repasscloud_consent';

    function update(granted) {
      if (granted && typeof window.repasscloudLoadAnalytics === 'function') {
        window.repasscloudLoadAnalytics();
        return;
      }
      if (typeof gtag === 'function') {
        gtag('consent', 'update', {
          analytics_storage: granted ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }
    }

    function read() {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch (e) {
        return null;
      }
    }

    function save(value) {
      try {
        localStorage.setItem(STORAGE_KEY, value);
      } catch (e) {
        // Storage unavailable: the choice applies to this page view only.
      }
    }

    function banner() {
      return document.getElementById('cookie-banner');
    }

    function show() {
      var b = banner();
      if (b) b.hidden = false;
    }

    function hide() {
      var b = banner();
      if (b) b.hidden = true;
    }

    function init() {
      var stored = read();
      if (stored === 'granted') update(true);
      else if (stored === 'denied') update(false);
      else show();

      var accept = document.getElementById('cookie-accept');
      var reject = document.getElementById('cookie-reject');
      if (accept)
        accept.addEventListener('click', function () {
          save('granted');
          update(true);
          hide();
        });
      if (reject)
        reject.addEventListener('click', function () {
          save('denied');
          update(false);
          hide();
        });
    }

    window.repasscloudOpenCookieBanner = function () {
      show();
      var accept = document.getElementById('cookie-accept');
      if (accept) accept.focus();
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
