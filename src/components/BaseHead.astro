---
import '../styles/site.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import {
  DEFAULT_OG_IMAGE,
  GA_MEASUREMENT_ID,
  HOME_TITLE,
  GTM_CONTAINER_ID,
  SITE_DESCRIPTION,
  SITE_TITLE,
} from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  /** Absolute or site-relative path to a static OG image (takes priority over `image`). */
  ogImagePath?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  updatedDate?: string;
  noIndex?: boolean;
  /** Site-relative path to use as the canonical URL instead of the current route. */
  canonical?: string;
  /** Use `title` verbatim, without the " | RePass Cloud" suffix. */
  exactTitle?: boolean;
  ogImageAlt?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  ogImagePath,
  type = 'website',
  pubDate,
  updatedDate,
  noIndex = false,
  canonical,
  exactTitle = false,
  ogImageAlt,
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);

// Keep titles near the 50-60 character range search engines display: the
// " | RePass Cloud" suffix is dropped when it would push a title past 65.
const suffixed = `${title} | ${SITE_TITLE}`;
const pageTitle =
  title === SITE_TITLE ? HOME_TITLE : exactTitle || suffixed.length > 65 ? title : suffixed;
const ogImage = ogImagePath
  ? new URL(ogImagePath, Astro.site).href
  : image
    ? new URL(image.src, Astro.url).href
    : new URL(DEFAULT_OG_IMAGE, Astro.site).href;
const hasGtm = GTM_CONTAINER_ID.startsWith('GTM-');
const hasGa = GA_MEASUREMENT_ID.startsWith('G-');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ffffff" />
<Font cssVariable="--font-sans" preload={[{ weight: '400' }, { weight: '700' }]} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="RePass Cloud News"
  href={new URL('rss.xml', Astro.site)}
/>
<link rel="canonical" href={canonicalURL} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = window.gtag || gtag;
  window.gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500,
  });

  try {
    if (window.localStorage.getItem('repasscloud_consent') === 'granted') {
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
    }
  } catch {
    // Ignore storage errors.
  }
</script>

{hasGtm && (
  <script is:inline define:vars={{ gtmId: GTM_CONTAINER_ID }}>
    ((windowRef, documentRef, scriptTag, dataLayerName, containerId) => {
      windowRef[dataLayerName] = windowRef[dataLayerName] || [];
      windowRef[dataLayerName].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const firstScript = documentRef.getElementsByTagName(scriptTag)[0];
      const tag = documentRef.createElement(scriptTag);
      const layer = dataLayerName !== 'dataLayer' ? `&l=${dataLayerName}` : '';
      tag.async = true;
      tag.src = `https://www.googletagmanager.com/gtm.js?id=${containerId}${layer}`;
      firstScript.parentNode?.insertBefore(tag, firstScript);
    })(window, document, 'script', 'dataLayer', gtmId);
  </script>
)}

{hasGa && (
  <Fragment>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
      window.gtag('js', new Date());
      window.gtag('config', gaId);
    </script>
  </Fragment>
)}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt ?? `${title} – RePass Cloud`} />
<meta property="og:site_name" content="RePass Cloud" />
<meta property="og:locale" content="en_AU" />
<meta name="twitter:creator" content="@repasscloud" />

{type === 'article' && pubDate && (
  <meta property="article:published_time" content={pubDate} />
)}
{type === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate} />
)}
{type === 'article' && (
  <meta property="article:author" content="RePass Cloud" />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@repasscloud" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
