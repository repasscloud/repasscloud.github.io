---
import { GITHUB_URL, LINKEDIN_URL, TWITTER_URL } from '../consts';
import { products } from '../data/products';
import { books } from '../data/books';
import { getOpenJobs } from '../lib/jobs';

const year = new Date().getFullYear();
const publishedBooks = books.filter((b) => b.page);
const openRoles = (await getOpenJobs()).length;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-brand" aria-label="RePass Cloud home">
          <img src="/brand/repasscloud-mark.svg" alt="" width="30" height="30" loading="lazy" />
          RePass Cloud
        </a>
        <p>Australian software company and publisher. We build and run our own products and publish the How-To-Use-AI.com books.</p>
      </div>

      <div>
        <h2>Products</h2>
        <ul>
          {products.map((p) => (
            <li>
              {p.destination === 'external' ? (
                <a href={p.href} target="_blank" rel="noopener">{p.name} ↗</a>
              ) : (
                <a href={p.href}>{p.name}</a>
              )}
            </li>
          ))}
          <li><a href="/archive/">Archive</a></li>
        </ul>
      </div>

      <div>
        <h2>Publishing</h2>
        <ul>
          <li><a href="/publishing/">How-To-Use-AI.com series</a></li>
          {publishedBooks.map((b) => (
            <li><a href={`/publishing/${b.slug}/`}>{b.title}</a></li>
          ))}
          <li><a href="/brand/">Brand and press</a></li>
        </ul>
      </div>

      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/engineering/">Engineering</a></li>
          <li><a href="/news/">News</a></li>
          <li><a href="/careers/">Careers{openRoles > 0 && ` (${openRoles} open ${openRoles === 1 ? 'role' : 'roles'})`}</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2>Elsewhere</h2>
        <ul>
          <li><a href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a></li>
          <li><a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn ↗</a></li>
          <li><a href={TWITTER_URL} target="_blank" rel="noopener">X ↗</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <span>&copy; {year} RePass Cloud Pty Ltd. ABN 74 642 243 801. Made in Adelaide and Sydney with <span class="heart" role="img" aria-label="love">♥</span></span>
      <ul>
        <li><a href="/legal/privacy-policy/">Privacy</a></li>
        <li><a href="/legal/terms-of-service/">Terms</a></li>
        <li><a href="/legal/refund-policy/">Refunds</a></li>
        <li>
          <!-- CCPA opt-out: must stay visible on every page -->
          <button type="button" class="linkish" data-open-cookie-banner aria-label="Your privacy choices: do not sell or share my personal information">
            <img src="/images/privacyoptions29x14.png" alt="" width="29" height="14" style="display:inline;vertical-align:-2px;margin-right:6px" />Your privacy choices
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll('[data-open-cookie-banner]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (typeof window.repasscloudOpenCookieBanner === 'function') window.repasscloudOpenCookieBanner();
    });
  });
</script>
