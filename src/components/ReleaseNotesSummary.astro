---
/**
 * Compact "Release notes" block for a product page: the most recent
 * versions with their dates and opening summary, each linking to its
 * section on /products/<slug>/release-notes/. The full notes live there.
 */
import type { Product } from '../data/products';
import { formatReleaseDate, getChangelog } from '../lib/changelog';

interface Props {
  product: Product;
  limit?: number;
}

const { product, limit = 3 } = Astro.props;
const href = product.releaseNotesHref;

const entries = product.changelogUrl
  ? (
      await getChangelog(product.changelogUrl, {
        linkBase: product.githubUrl ? `${product.githubUrl}/blob/main/` : undefined,
      })
    ).slice(0, limit)
  : [];
---

<div class="rns">
  <div class="sec-head">
    <h2>Release notes</h2>
    {href && <p><a class="text-link" href={href}>All release notes for {product.name}</a></p>}
  </div>
  {entries.length > 0 && (
    <ul class="rows rns-rows">
      {entries.map((entry) => (
        <li>
          <div>
            <h3>
              {entry.unreleased ? 'Unreleased' : `v${entry.version}`}
              {entry.date && <time class="rns-date" datetime={entry.date}>{formatReleaseDate(entry.date)}</time>}
            </h3>
            {entry.summaryHtml && <p set:html={entry.summaryHtml} />}
          </div>
          {href && (
            <a class="go" href={`${href}#${entry.id}`}>
              Read<span class="sr-only"> the {entry.unreleased ? 'unreleased' : `v${entry.version}`} notes</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .rns .sec-head {
    margin-bottom: 24px;
  }

  .rns-rows > li {
    grid-template-columns: 1fr auto;
  }

  .rns-rows .go {
    grid-column: auto;
  }

  .rns-rows h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 0 0 4px;
    font-size: 1.15rem;
  }

  .rns-date {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--magenta);
  }

  .rns-rows p {
    margin: 0;
  }
</style>
