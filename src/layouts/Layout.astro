---
import BaseHead from '../components/BaseHead.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { ImageMetadata } from 'astro';
import { GTM_CONTAINER_ID, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  ogImagePath?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  updatedDate?: string;
  noIndex?: boolean;
  canonical?: string;
  exactTitle?: boolean;
  ogImageAlt?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  ogImagePath,
  type = 'website',
  pubDate,
  updatedDate,
  noIndex = false,
  canonical,
  exactTitle = false,
  ogImageAlt,
} = Astro.props;

const hasGtm = GTM_CONTAINER_ID.startsWith('GTM-');
---

<!doctype html>
<html lang="en-AU">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogImagePath={ogImagePath}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      noIndex={noIndex}
      canonical={canonical}
      exactTitle={exactTitle}
      ogImageAlt={ogImageAlt}
    />
    <slot name="head" />
  </head>
  <body>
    {hasGtm && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_CONTAINER_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
