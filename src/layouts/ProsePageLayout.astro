---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    /** Optional full <title>; defaults to "<title> | RePass Cloud". */
    seoTitle?: string;
    sectionLabel?: string;
    noIndex?: boolean;
  };
}

const { frontmatter } = Astro.props;
const path = Astro.url.pathname;
const section = path.startsWith('/legal/')
  ? { href: '/legal/', label: 'Legal' }
  : path.startsWith('/careers/')
    ? { href: '/careers/', label: 'Careers' }
    : null;
---

<Layout
  title={frontmatter.seoTitle ?? frontmatter.title}
  exactTitle={Boolean(frontmatter.seoTitle)}
  description={frontmatter.description}
  noIndex={frontmatter.noIndex}
>
  <section class="page-hero">
    <div class="wrap-narrow">
      {section && (
        <ol class="breadcrumb">
          <li><a href={section.href}>{section.label}</a></li>
          <li aria-current="page">{frontmatter.title}</li>
        </ol>
      )}
      <h1 class="prose-title">{frontmatter.title}</h1>
      {frontmatter.description && <p class="lead">{frontmatter.description}</p>}
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap-narrow">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</Layout>

<style>
  .prose-title {
    font-size: clamp(2rem, 4vw, 3rem);
  }
</style>
