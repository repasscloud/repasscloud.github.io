---
import RedirectPage from '../../components/RedirectPage.astro';
import { newsSlugRedirects } from '../../data/newsRedirects';

export function getStaticPaths() {
  return Object.entries(newsSlugRedirects).map(([oldSlug, newSlug]) => ({
    params: { slug: oldSlug },
    props: { newSlug },
  }));
}

const { newSlug } = Astro.props;
---

<RedirectPage to={`/news/${newSlug}/`} title="This post has moved to News" />
