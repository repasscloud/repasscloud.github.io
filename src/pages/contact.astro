---
import Layout from '../layouts/Layout.astro';
import { COMPANY_ABN, COMPANY_ADDRESS, COMPANY_LEGAL_NAME, CONTACT_EMAIL } from '../consts';
import { TOPICS } from '../../cloudflare/contact';

const topics = Object.entries(TOPICS);
---

<Layout
  title="Contact RePass Cloud: Products, Books, Media and Engineering"
  exactTitle
  description="Contact RePass Cloud about CurseDelete licensing, product support, the How-To-Use-AI.com books, media requests, careers or enterprise engineering work."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Contact us</h1>
      <p class="lead">Questions about a product, a book, licensing or engineering work. Send a message and it comes straight to our team.</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap contact-grid">
      <div>
        <div id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></div>

        <form id="contact-form" class="form" method="post" action="/api/contact" novalidate>
          <div class="row">
            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" />
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="254" />
              <span class="hint">We reply to this address.</span>
            </div>
          </div>
          <div class="row">
            <div class="field">
              <label for="cf-company">Organisation <span class="muted">(optional)</span></label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="160" />
            </div>
            <div class="field">
              <label for="cf-topic">Topic</label>
              <select id="cf-topic" name="topic">
                {topics.map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" required minlength="10" maxlength="5000"></textarea>
          </div>

          <input type="hidden" name="role" id="cf-role" />
          <input type="hidden" name="started" id="cf-started" />
          <div class="hp-field" aria-hidden="true">
            <label for="cf-website">Leave this field empty</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p class="muted small" style="margin:0">
            Please do not include passwords, API keys, payment-card details, unnecessary confidential information or
            sensitive personal information. We will use the information you provide to respond to and administer your
            enquiry in accordance with our <a href="/legal/privacy-policy/">Privacy Policy</a>.
          </p>
          <div>
            <button class="btn btn-primary" type="submit" id="cf-submit">Send message</button>
          </div>
        </form>
      </div>

      <aside class="contact-aside">
        <h2>Other ways to reach us</h2>
        <dl class="kv">
          <div><dt>Email</dt><dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd></div>
          <div><dt>Company</dt><dd>{COMPANY_LEGAL_NAME}</dd></div>
          <div><dt>ABN</dt><dd>{COMPANY_ABN}</dd></div>
          <div><dt>Address</dt><dd>{COMPANY_ADDRESS}</dd></div>
          <div><dt>Privacy</dt><dd>Privacy requests or complaints: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd></div>
        </dl>
        <h3>Looking for something specific?</h3>
        <ul class="aside-links">
          <li><a href="/products/cursedelete/#licensing">CurseDelete editions and licensing</a></li>
          <li><a href="/publishing/ai-for-normal-people/">Buying AI for Normal People</a></li>
          <li><a href="/brand/">Logos, cover art and press assets</a></li>
          <li><a href="/careers/">Open roles</a></li>
        </ul>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const submit = document.getElementById('cf-submit');
    if (!form || !status || !submit) return;

    const params = new URLSearchParams(location.search);
    const topic = params.get('topic');
    const role = params.get('role');
    const select = document.getElementById('cf-topic');
    if (topic && select && select.querySelector(`option[value="${CSS.escape(topic)}"]`)) select.value = topic;
    if (role) {
      document.getElementById('cf-role').value = role.slice(0, 160);
      const msg = document.getElementById('cf-message');
      if (msg && !msg.value) msg.placeholder = `About the ${role.slice(0, 160)} role: include a link to your CV and your work.`;
    }
    document.getElementById('cf-started').value = String(Date.now());

    const show = (kind, text) => {
      status.hidden = false;
      status.dataset.kind = kind;
      status.textContent = text;
      status.focus();
    };

    // Results of a no-JavaScript form post come back as ?sent=1 or ?error=1.
    if (params.get('sent')) show('ok', "Message sent. Thanks, we'll reply to the email address you gave.");
    if (params.get('error')) show('error', "Your message couldn't be sent. Try again, or email hello@repasscloud.com.");

    const clearErrors = () => {
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll('.field-error').forEach((el) => el.remove());
    };

    const markError = (name, text) => {
      const input = form.elements.namedItem(name);
      if (!(input instanceof HTMLElement)) return;
      input.setAttribute('aria-invalid', 'true');
      const note = document.createElement('span');
      note.className = 'hint field-error';
      note.style.color = 'var(--danger)';
      note.id = `${input.id}-error`;
      note.textContent = text;
      input.setAttribute('aria-describedby', note.id);
      input.insertAdjacentElement('afterend', note);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const data = Object.fromEntries(new FormData(form).entries());
      const local = {};
      if (!String(data.name || '').trim()) local.name = 'Enter your name.';
      if (!/^[^\s@<>"]+@[^\s@<>"]+\.[^\s@<>"]{2,}$/.test(String(data.email || '').trim())) local.email = 'Enter an email address we can reply to, like name@example.com.';
      if (String(data.message || '').trim().length < 10) local.message = 'Write a message of at least 10 characters.';
      if (Object.keys(local).length) {
        Object.entries(local).forEach(([k, v]) => markError(k, v));
        show('error', 'Check the highlighted fields.');
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          form.reset();
          document.getElementById('cf-started').value = String(Date.now());
          show('ok', "Message sent. Thanks, we'll reply to the email address you gave.");
        } else {
          if (body.fieldErrors) Object.entries(body.fieldErrors).forEach(([k, v]) => markError(k, v));
          show('error', body.error || "Your message couldn't be sent. Try again, or email hello@repasscloud.com.");
        }
      } catch {
        show('error', "Your message couldn't be sent. Check your connection and try again, or email hello@repasscloud.com.");
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send message';
      }
    });
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 72px;
    align-items: start;
  }

  #form-status {
    margin-bottom: 24px;
  }

  .contact-aside h2 {
    font-size: 1.3rem;
    margin-bottom: 16px;
  }

  .contact-aside :global(.kv div) {
    grid-template-columns: 90px 1fr;
  }

  .contact-aside h3 {
    font-size: 1.05rem;
    margin: 36px 0 10px;
  }

  .aside-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .aside-links li {
    padding: 8px 0;
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
