---
import Layout from '../layouts/Layout.astro';

const principles = [
  {
    title: 'Engineering before presentation',
    description:
      'We start with system behavior, control points, and integration realities before visual polish or documentation layers.',
  },
  {
    title: 'Governance as a design input',
    description:
      'Auditability, permissions, evidence trails, and supportability are part of architecture decisions from the start.',
  },
  {
    title: 'Product ownership',
    description:
      'Products we ship, we also operate and support ourselves — the same accountability applies whether it is a product or a client system.',
  },
];

const focusAreas = [
  'Software product engineering (Rust, .NET)',
  'Multi-tenant enterprise platforms',
  'Cloud governance and FinOps tooling',
  'Microsoft 365 and Entra identity automation',
  'PowerShell delivery and operational tooling',
  'Integration-heavy business systems',
];
---

<Layout
  title="Company"
  description="RePass Cloud is an Australian software company that designs, builds, owns, and operates software products and enterprise technical systems."
>
  <section class="page-hero">
    <div class="container">
      <div class="hero-eyebrow"><i class="bi bi-building"></i> Company</div>
      <h1>An Australian software company that builds and operates its own products.</h1>
      <p class="hero-lead">
        RePass Cloud designs, builds, owns, and operates software products, and delivers serious
        enterprise engineering work for teams working across cloud estates and identity-heavy
        workflows.
      </p>
      <div class="hero-actions">
        <a href="/products" class="btn btn-primary btn-lg">Explore our products <i class="bi bi-arrow-right"></i></a>
        <a href="/case-studies" class="btn btn-outline btn-lg">See case studies</a>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <div class="showcase-split">
        <div>
          <div class="section-label">What we do</div>
          <h2>Product ownership, plus enterprise delivery depth.</h2>
          <p class="section-intro">
            We build and operate our own named products, and we design and ship enterprise systems
            where identity, controls, integration, and support all have to work together in
            production.
          </p>
        </div>
        <div class="showcase-panel">
          <div class="section-label">Technical areas</div>
          <div class="hero-trust">
            {focusAreas.map((item) => (
              <div class="hero-trust-item"><i class="bi bi-check2-circle"></i> {item}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="text-center" style="margin-bottom:2rem;">
        <div class="section-label">Operating principles</div>
        <h2>How we execute</h2>
      </div>
      <div class="grid-3">
        {principles.map((item) => (
          <div class="feature-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <div class="showcase-split">
        <div>
          <div class="section-label">Products</div>
          <h2>Where to find what we build</h2>
          <p class="text-muted">
            Current products include CurseDelete 2, hosted directly on repasscloud.com, and
            Cinturon360, our multi-tenant operational control platform.
          </p>
          <a href="/products" class="btn btn-primary btn-sm">See all products <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="showcase-visual">
          <i class="bi bi-diagram-3-fill" style="font-size:2.5rem;"></i>
          <div style="font-weight:700; margin-top:0.6rem;">Identity-aware control software</div>
          <div style="font-size:0.85rem; opacity:0.8; margin-top:0.4rem;">Multi-tenant · Audit-ready · Delegated admin</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align:center; max-width:60ch;">
      <p class="text-muted">
        Have a genuine enquiry? <a href="/contact">Contact us</a>.
      </p>
    </div>
  </section>
</Layout>
