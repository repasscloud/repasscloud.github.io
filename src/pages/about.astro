---
import Layout from '../layouts/Layout.astro';
import ProductRows from '../components/ProductRows.astro';
import { COMPANY_ABN, COMPANY_LEGAL_NAME } from '../consts';
import { SERIES } from '../data/books';

const principles = [
  {
    title: 'Engineering before presentation',
    description:
      'We start with system behaviour, control points and integration realities, then add polish and documentation.',
  },
  {
    title: 'Governance as a design input',
    description:
      'Auditability, permissions, evidence trails and supportability are part of architecture decisions from the start.',
  },
  {
    title: 'We own what we ship',
    description:
      'Products and books we publish, we also maintain and support. The same accountability applies to client systems.',
  },
];

const focusAreas = [
  'Software product engineering in Rust and .NET',
  'Multi-tenant enterprise platforms',
  'Cloud governance and FinOps tooling',
  'Microsoft 365 and Entra ID identity automation',
  'PowerShell delivery and operational tooling',
  'Practical AI education and publishing',
];
---

<Layout
  title="About RePass Cloud: Australian Software Company and Publisher"
  exactTitle
  description="RePass Cloud Pty Ltd is an Australian company that designs, builds and operates its own software products and publishes the How-To-Use-AI.com book series."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>An Australian software company that builds, runs and publishes its own work</h1>
      <p class="lead">
        RePass Cloud designs, builds and operates software products, publishes the {SERIES.name} books,
        and delivers enterprise engineering for teams with demanding cloud and identity estates.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split-wide">
      <div>
        <h2 style="margin-bottom:20px">What we do</h2>
        <p class="muted">
          We build and operate our own named products. We publish books that explain AI to people who
          have to use it, not just read about it. And we design and ship enterprise systems where identity,
          controls, integration and support all have to work together in production.
        </p>
      </div>
      <div>
        <h3 style="margin-bottom:12px">Technical areas</h3>
        <ul class="area-list">
          {focusAreas.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="sec-head"><h2>How we work</h2></div>
      <dl class="caps three">
        {principles.map((p) => (
          <div><dt>{p.title}</dt><dd>{p.description}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2 style="margin-bottom:12px">Products</h2>
        <p class="muted">Software we design, build and operate.</p>
        <ProductRows />
      </div>
      <div>
        <h2 style="margin-bottom:12px">Publishing</h2>
        <p class="muted">{SERIES.about}</p>
        <p><a class="text-link" href="/publishing/">The {SERIES.name} series</a></p>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split">
      <div>
        <h2 style="margin-bottom:20px">Company details</h2>
        <dl class="kv">
          <div><dt>Legal name</dt><dd>{COMPANY_LEGAL_NAME}</dd></div>
          <div><dt>ABN</dt><dd>{COMPANY_ABN}</dd></div>
          <div><dt>Country</dt><dd>Australia</dd></div>
          <div><dt>Contact</dt><dd><a href="/contact/">Send us a message</a></dd></div>
        </dl>
      </div>
      <div>
        <h2 style="margin-bottom:20px">Also here</h2>
        <dl class="kv">
          <div><dt>Careers</dt><dd><a href="/careers/">Open roles</a></dd></div>
          <div><dt>Brand assets</dt><dd><a href="/brand/">Logos and press</a></dd></div>
          <div><dt>Archive</dt><dd><a href="/archive/">Retired projects</a></dd></div>
          <div><dt>Legal</dt><dd><a href="/legal/">Policies</a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</Layout>

<style>
  .area-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .area-list li {
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
</style>
