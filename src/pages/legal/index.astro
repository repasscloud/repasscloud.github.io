---
import Layout from '../../layouts/Layout.astro';

const legalLinks = [
  { href: '/legal/privacy-policy/', icon: 'bi-shield-check', title: 'Privacy Policy', desc: 'How we collect, use, and protect personal information.' },
  { href: '/legal/terms-of-service/', icon: 'bi-file-text', title: 'Terms of Service', desc: 'Terms governing access to and use of our websites, products, and services.' },
  { href: '/legal/refund-policy/', icon: 'bi-arrow-return-left', title: 'Refund Policy', desc: 'Refund eligibility and process for paid subscriptions and services.' },
];

const legacyLinks = [
  { href: '/legal/lunavpn/lunavpn-cancellation-policy/', icon: 'bi-info-circle', title: 'LunaVPN Closure Notice', desc: 'Notice confirming LunaVPN is closed and accounts are terminated.' },
];
---

<Layout
  title="Legal"
  description="Legal documents for RePass Cloud Pty Ltd — Privacy Policy, Terms of Service, and Refund Policy."
>
  <section class="page-hero">
    <div class="container">
      <div class="hero-eyebrow"><i class="bi bi-file-earmark-text"></i> RePass Cloud Pty Ltd</div>
      <h1>Legal</h1>
      <p class="hero-lead">Legal policies and notices for RePass Cloud Pty Ltd and its services.</p>
    </div>
  </section>

  <section class="section-sm bg-surface">
    <div class="container container-narrow">
      <ul class="link-list">
        {legalLinks.map((link) => (
          <li>
            <a href={link.href} class="link-row">
              <i class={`bi ${link.icon} link-row-icon`}></i>
              <span class="link-row-label">
                {link.title}
                <span class="text-sm text-muted">{link.desc}</span>
              </span>
              <i class="bi bi-arrow-right link-row-arrow"></i>
            </a>
          </li>
        ))}
        {legacyLinks.map((link) => (
          <li>
            <a href={link.href} class="link-row" style="opacity:0.7;">
              <i class={`bi ${link.icon} link-row-icon`}></i>
              <span class="link-row-label">
                {link.title}
                <span class="text-sm text-muted">{link.desc}</span>
              </span>
              <i class="bi bi-arrow-right link-row-arrow"></i>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
