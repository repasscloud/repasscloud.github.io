---
import Layout from '../../../layouts/Layout.astro';
import Changelog from '../../../components/Changelog.astro';
import {
  CONTACT_EMAIL,
  CURSEDELETE_CHANGELOG_URL,
  CURSEDELETE_GITHUB_URL,
  CURSEDELETE_ICON,
  CURSEDELETE_OG_IMAGE,
  CURSEDELETE_STRIPE_LINKS,
  CURSEDELETE_VERSION,
} from '../../../consts';

const platforms = [
  { name: 'macOS', status: 'Implemented and tested', detail: 'Native Darwin/POSIX primitives (openat/unlinkat/fstatat) — the reference PlatformEngine implementation.' },
  { name: 'Windows', status: 'Implemented', detail: 'Native Win32 primitives (FindFirstFileExW, FILE_DISPOSITION_INFO_EX with DeleteFileW/RemoveDirectoryW fallback), ownership/ACL remediation, Restart Manager for --kill-locks.' },
  { name: 'Linux', status: 'Implemented', detail: 'Native openat/unlinkat/statx primitives via libc, with /proc-based local lock-holder discovery for --kill-locks.' },
];

const features = [
  { title: 'Streaming deletion', desc: 'Enumeration and deletion overlap — deletion starts before the tree is fully walked, with bounded memory use regardless of tree size.' },
  { title: 'Adaptive concurrency', desc: '--workers auto hill-climbs to a good worker count for the storage target it is running against, or --workers N gives an exact override.' },
  { title: 'Structural root protection', desc: 'A filesystem or SMB share root can never be deleted — including via a symlink or junction disguising one — enforced by two independently tested layers.' },
  { title: 'Symlink-safe traversal', desc: 'A symlink or junction found inside a target tree is always deleted as the link object itself, never followed.' },
  { title: 'Retention cleanup', desc: '--age/--age-by with a mandatory duration unit; directories are removed only once genuinely empty, and the target directory itself is always preserved.' },
  { title: 'Composable filters', desc: '--include/--exclude/--min-size/--max-size, with exclude always winning ties.' },
  { title: 'Machine-readable output', desc: '--json with a versioned schema and a frozen exit-code contract for automation.' },
  { title: 'Lock handling', desc: '--kill-locks for local process locks, and a Business/Enterprise-only --close-remote-locks for supported Windows file servers.' },
];

const editions = [
  { key: 'community', name: 'Community', price: 'Free', who: 'Personal use, developers, homelabs, evaluation', cta: 'Get Community' },
  { key: 'education', name: 'Education', price: 'Free', who: 'Students, teachers, recognised schools and universities', cta: 'Get Education' },
  { key: 'business', name: 'Business', price: '$199 AUD', who: 'IT departments, DevOps teams, MSPs, file-server admins, build/release infrastructure', cta: 'Purchase Business' },
  { key: 'enterprise', name: 'Enterprise', price: '$1499 AUD', who: 'Organisation-wide deployment, negotiated scale, priority support', cta: 'Purchase Enterprise' },
] as const;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CurseDelete 2',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  softwareVersion: CURSEDELETE_VERSION,
  description:
    'CurseDelete 2 is a native, high-performance deletion engine for files and directory trees, built in Rust, with streaming deletion, adaptive concurrency, and structural root protection.',
  url: 'https://repasscloud.com/products/cursedelete/',
  image: new URL(CURSEDELETE_ICON, 'https://repasscloud.com').href,
  author: {
    '@type': 'Organization',
    name: 'RePass Cloud Pty Ltd',
    url: 'https://repasscloud.com',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Products', item: 'https://repasscloud.com/products' },
    { '@type': 'ListItem', position: 2, name: 'CurseDelete 2', item: 'https://repasscloud.com/products/cursedelete/' },
  ],
};

---

<Layout
  title="CurseDelete 2: Fast, Safe Deletion for Huge Directory Trees"
  exactTitle
  description="CurseDelete 2 is a native Rust deletion engine for huge directory trees, with streaming deletion, adaptive concurrency and structural root protection."
  ogImagePath={CURSEDELETE_OG_IMAGE}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="page-hero cd-hero">
    <div class="wrap cd-hero-grid">
      <div>
        <ol class="breadcrumb">
          <li><a href="/products/">Products</a></li>
          <li aria-current="page">CurseDelete 2</li>
        </ol>
        <div class="cd-title">
          <img src={CURSEDELETE_ICON} alt="" width="64" height="64" />
          <h1>CurseDelete 2</h1>
        </div>
        <p class="lead">
          A native, high-performance deletion engine for files and directory trees that refuse to die.
          It deletes while it scans, tunes its own concurrency to the storage it runs on, and will never
          delete a filesystem or SMB share root.
        </p>
        <div class="actions">
          <a href="#licensing" class="btn btn-primary">Editions and licensing</a>
          <a href={CURSEDELETE_GITHUB_URL} class="btn btn-quiet" target="_blank" rel="noopener">Source on GitHub ↗</a>
        </div>
        <dl class="facts">
          <div><dt>Version</dt><dd>{CURSEDELETE_VERSION}</dd></div>
          <div><dt>Platforms</dt><dd>macOS, Windows, Linux</dd></div>
          <div><dt>Binary</dt><dd><code>cursdel</code> (Rust)</dd></div>
        </dl>
      </div>
      <pre class="terminal cd-term" aria-label="Example dry run output"><span class="prompt">$</span> cursdel /tmp/scratch/old-build --dry-run
CurseDelete 2

Target:       /tmp/scratch/old-build
Mode:         normal (dry-run)
Workers:      auto -&gt; 10

Files scanned:       4
Directories scanned: 3

Would delete:
  Files:             4
  Directories:       3
  Data:              20.0 B

<span class="ok">No files were modified.</span></pre>
    </div>
  </section>

  <section class="section">
    <div class="wrap split-wide">
      <div>
        <h2 style="margin-bottom:20px">Deleting large or difficult trees, safely and fast</h2>
        <p class="muted">
          Standard delete tools either walk a whole tree into memory before acting, or offer no protection
          against deleting a filesystem or share root. CurseDelete streams deletion as it enumerates, so
          memory stays bounded whatever the tree size, and root protection is enforced structurally by two
          independently tested layers.
        </p>
      </div>
      <div>
        <h3 style="margin-bottom:12px">Where it earns its keep</h3>
        <ul class="checks">
          <li>Retention cleanup for aged files and logs</li>
          <li>Build, release and CI cleanup jobs</li>
          <li>Large or slow storage: network shares and spinning disks</li>
          <li>Locked-file remediation on Windows file servers</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="sec-head"><h2>Features</h2></div>
      <dl class="caps three">
        {features.map((item) => (
          <div><dt>{item.title}</dt><dd>{item.desc}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head"><h2>Platform support</h2><p>Each platform uses its own native filesystem primitives rather than a portability layer.</p></div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th scope="col">Platform</th><th scope="col">Status</th><th scope="col">Implementation</th></tr></thead>
          <tbody>
            {platforms.map((p) => (
              <tr><th scope="row" style="color:var(--ink);font-size:1rem">{p.name}</th><td style="white-space:nowrap">{p.status}</td><td class="muted">{p.detail}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split-wide">
      <div>
        <h2 style="margin-bottom:20px">Install</h2>
        <p class="muted">
          Prebuilt release binaries aren't published yet, so building from source is currently the only way
          to get <code>cursdel</code>. You need a current stable Rust toolchain.
        </p>
        <p><a class="text-link" href={CURSEDELETE_GITHUB_URL} target="_blank" rel="noopener">Source and documentation ↗</a></p>
      </div>
      <pre class="terminal" style="align-self:center"><code>git clone {CURSEDELETE_GITHUB_URL}.git
cd cursedelete-2
cargo build --release -p cursdel-cli
./target/release/cursdel --version</code></pre>
    </div>
  </section>

  <section id="licensing" class="section">
    <div class="wrap">
      <div class="sec-head">
        <h2>Editions</h2>
        <p>
          The full deletion engine runs at full speed in every edition, including the free Community
          edition. Paid editions cover commercial-use rights, scale and support. The only feature gated at
          runtime is <code>--close-remote-locks</code>.
        </p>
      </div>
      <div class="editions">
        {editions.map((edition) => (
          <div class="edition">
            <h3>{edition.name}</h3>
            <p class="price">{edition.price}</p>
            <p class="muted small">{edition.who}</p>
            <a href={CURSEDELETE_STRIPE_LINKS[edition.key]} class={`btn ${edition.price === 'Free' ? 'btn-quiet' : 'btn-primary'} btn-sm`} target="_blank" rel="noopener">
              {edition.cta}
            </a>
          </div>
        ))}
      </div>
      <p class="muted small" style="margin-top:24px">
        Payments are processed by Stripe and licences are issued after purchase. For questions about
        editions, scale or Enterprise terms, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="wrap-narrow">
      <h2 style="margin-bottom:28px">Release notes</h2>
      <Changelog url={CURSEDELETE_CHANGELOG_URL} />
    </div>
  </section>
</Layout>

<style>
  .cd-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  .cd-title {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .cd-title img {
    width: 64px;
    height: 64px;
    border-radius: 14px;
  }

  .cd-term {
    margin: 0;
  }

  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .checks li {
    position: relative;
    padding: 12px 0 12px 30px;
    border-top: 1px solid var(--line);
  }

  .checks li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 19px;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--violet);
    border-bottom: 2px solid var(--violet);
    transform: rotate(-45deg);
  }

  .editions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .edition {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .edition .price {
    margin: 6px 0 10px;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .edition .btn {
    margin-top: auto;
  }

  @media (max-width: 960px) {
    .cd-hero-grid {
      grid-template-columns: 1fr;
    }

    .editions {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .editions {
      grid-template-columns: 1fr;
    }
  }
</style>
