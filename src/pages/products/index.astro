---
import Layout from '../../layouts/Layout.astro';
import { SITE_DOMAIN } from '../../consts';
import { products } from '../../data/products';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: product.name,
    url: new URL(product.href, SITE_DOMAIN).href,
  })),
};

const hostOf = (url: string) => new URL(url).host.replace(/^www\./, '');
---

<Layout
  title="Software Products We Build and Operate"
  description="Software designed, built and operated by RePass Cloud: CurseDelete 2 for fast, safe deletion, Cinturon360 for enterprise control, and Aethon Jobs for hiring."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <section class="page-hero">
    <div class="wrap">
      <h1>Software we design, build and operate</h1>
      <p class="lead">
        Every product here is owned and supported by RePass Cloud. Some live on this site; others have
        their own home on the web.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap">
      <div class="product-list">
        {products.map((p) => (
          <article class="product">
            <div class="product-ico" style={`background:${p.iconImage ? 'var(--ink)' : p.colour}`} aria-hidden="true">
              {p.iconImage ? <img src={p.iconImage} alt="" width="72" height="72" loading="lazy" /> : p.monogram}
            </div>
            <div class="product-body">
              <p class="kicker">{p.kind}</p>
              <h2>
                {p.destination === 'internal' ? <a href={p.href}>{p.name}</a> : p.name}
                {p.version && <span class="tag">{p.version}</span>}
              </h2>
              <p class="product-tagline">{p.tagline}</p>
              <p class="muted">{p.description}</p>
              <ul class="tags" aria-label="Technology">
                {p.tags.map((t) => <li class="tag tag-neutral">{t}</li>)}
              </ul>
            </div>
            <div class="product-actions">
              {p.destination === 'external' ? (
                <a class="btn btn-quiet" href={p.href} target="_blank" rel="noopener">Visit {hostOf(p.href)} ↗</a>
              ) : (
                <a class="btn btn-primary" href={p.href}>Product details<span class="sr-only">: {p.name}</span></a>
              )}
              {p.githubUrl && (
                <a class="btn btn-quiet" href={p.githubUrl} target="_blank" rel="noopener">Source on GitHub ↗</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <p class="muted small" style="margin-top:40px">
        Looking for an older project? Retired and open-source work is in the <a href="/archive/">archive</a>.
      </p>
    </div>
  </section>
</Layout>

<style>

  .product {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 32px;
    padding: 40px 0;
    border-bottom: 1px solid var(--line);
  }

  .product:first-child {
    padding-top: 8px;
  }

  .product:last-child {
    border-bottom: 0;
  }

  .product-ico {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #fff;
    font-weight: 800;
    font-size: 1.4rem;
  }

  .product-ico img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product h2 {
    font-size: 1.9rem;
    margin-bottom: 8px;
  }

  .product h2 a {
    color: inherit;
    text-decoration: none;
  }

  .product h2 a:hover {
    color: var(--violet);
  }

  .product h2 .tag {
    margin-left: 10px;
    vertical-align: 6px;
  }

  .product-tagline {
    font-size: 1.12rem;
    font-weight: 500;
    color: var(--ink);
    max-width: 60ch;
  }

  .product-body .muted {
    max-width: 68ch;
  }

  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 220px;
  }

  @media (max-width: 860px) {
    .product {
      grid-template-columns: 56px 1fr;
      gap: 20px;
    }

    .product-ico {
      width: 56px;
      height: 56px;
      border-radius: 13px;
      font-size: 1.1rem;
    }

    .product-actions {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      min-width: 0;
    }
  }

  @media (max-width: 600px) {
    .product {
      grid-template-columns: 1fr;
    }

    .product-actions {
      grid-column: 1;
    }

    .product-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
