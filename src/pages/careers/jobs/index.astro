---
import Layout from '../../../layouts/Layout.astro';

const roles = [
  { href: '/careers/jobs/senior-dotnet-engineer/', icon: 'bi-code-slash', title: 'Senior .NET Engineer', meta: 'Contract · Remote (Australia / International)' },
  { href: '/careers/jobs/platform-engineer/', icon: 'bi-hdd-stack', title: 'Platform Engineer', meta: 'Contract · Remote' },
  { href: '/careers/jobs/infrastructure-automation-engineer/', icon: 'bi-gear', title: 'Infrastructure & Automation Engineer', meta: 'Contract · Remote' },
];
---

<Layout
  title="Open Roles"
  description="Current engineering opportunities at RePass Cloud Pty Ltd."
>
  <section class="page-hero">
    <div class="container">
      <div class="hero-eyebrow"><i class="bi bi-briefcase"></i> Careers</div>
      <h1>Open Roles</h1>
      <p class="hero-lead">
        Current opportunities at RePass Cloud. We hire engineers who build real things.
      </p>
    </div>
  </section>

  <section class="section-sm bg-surface">
    <div class="container container-narrow">
      <div class="aethon-card" style="border-left: 4px solid var(--rpc-primary);">
        <p>
          We don't always post open roles publicly. If you are a strong engineer interested in
          enterprise software, cloud automation, identity systems, or developer tooling — get in
          touch. Tell us what you build and why you're interested.
        </p>
        <div style="margin-top:1.1rem;">
          <a href="/contact" class="btn btn-primary">Send us a message <i class="bi bi-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container container-narrow">
      <div class="section-label">Listed roles</div>
      <h2 style="font-size:1.25rem; margin-bottom:1.5rem;">Current openings</h2>
      <ul class="link-list">
        {roles.map((role) => (
          <li>
            <a href={role.href} class="link-row">
              <i class={`bi ${role.icon} link-row-icon`}></i>
              <span class="link-row-label">
                {role.title}
                <span class="text-sm text-muted">{role.meta}</span>
              </span>
              <i class="bi bi-arrow-right link-row-arrow"></i>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
