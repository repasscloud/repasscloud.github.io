---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { employmentLabel, getOpenJobs, locationLabel } from '../../lib/jobs';

const jobs = await getOpenJobs();

const hiringInfo = [
  { href: '/careers/how-we-hire/', label: 'How we hire', desc: 'Our process, from application to offer.' },
  { href: '/careers/culture/', label: 'Culture and belonging', desc: 'How we work and what we value.' },
  { href: '/careers/candidate-guide/', label: 'Candidate guide', desc: 'What to expect and how to prepare.' },
  { href: '/careers/equal-opportunity/', label: 'Equal opportunity', desc: 'Our commitment to fair hiring.' },
  { href: '/careers/applicant-privacy-notice/', label: 'Applicant privacy notice', desc: 'How we handle your information.' },
];
---

<Layout
  title="Careers at RePass Cloud: Engineering Jobs in Australia"
  exactTitle
  description={jobs.length > 0
    ? `Open roles at RePass Cloud, an Australian software company: ${jobs.length} remote-friendly engineering ${jobs.length === 1 ? 'role' : 'roles'} building products and enterprise systems.`
    : 'Careers at RePass Cloud, an Australian software company and publisher. No roles are open right now; see how we hire and get in touch for future roles.'}
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Careers</h1>
      <p class="lead">
        We hire engineers and collaborators who build real things: people who take ownership, write
        clearly, and care about the quality of what they ship. We're remote-friendly and judge output,
        not hours at a desk.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap">
      <h2 style="margin-bottom:24px">Open roles</h2>
      {jobs.length > 0 ? (
        <ul class="jobs">
          {jobs.map((job) => (
            <li>
              <div>
                <h3><a href={`/careers/jobs/${job.id}/`}>{job.data.title}</a></h3>
                <p class="muted">{job.data.summary}</p>
              </div>
              <dl class="job-meta">
                <div><dt class="sr-only">Type</dt><dd>{employmentLabel(job)}</dd></div>
                <div><dt class="sr-only">Location</dt><dd>{locationLabel(job)}</dd></div>
                <div><dt class="sr-only">Posted</dt><dd>Posted <FormattedDate date={job.data.datePosted} /></dd></div>
              </dl>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <h3>No jobs currently open</h3>
          <p class="muted">
            We don't have any open roles right now. New roles are listed here first. If you'd like to be
            considered for future work, <a href="/contact/?topic=careers">send us a short note</a> with a link
            to your work.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="section-sm band">
    <div class="wrap">
      <h2 style="margin-bottom:24px">Hiring information</h2>
      <dl class="caps three">
        {hiringInfo.map((i) => (
          <div><dt><a href={i.href}>{i.label}</a></dt><dd>{i.desc}</dd></div>
        ))}
      </dl>
    </div>
  </section>
</Layout>

<style>
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .jobs li {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .jobs h3 {
    font-size: 1.35rem;
    margin-bottom: 8px;
  }

  .jobs h3 a {
    color: var(--ink);
  }

  .jobs h3 a:hover {
    color: var(--violet);
  }

  .jobs .muted {
    margin: 0;
    max-width: 64ch;
  }

  .job-meta {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .job-meta dd {
    margin: 0 0 4px;
  }

  .empty {
    padding: 36px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    max-width: 720px;
  }

  .empty h3 {
    font-size: 1.4rem;
    margin-bottom: 10px;
  }

  .empty p {
    margin: 0;
  }

  .caps dt a {
    color: var(--ink);
  }

  .caps dt a:hover {
    color: var(--violet);
  }

  @media (max-width: 760px) {
    .jobs li {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .empty {
      padding: 24px;
    }
  }
</style>
