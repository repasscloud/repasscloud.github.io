---
import Layout from '../../layouts/Layout.astro';
import { GITHUB_URL } from '../../consts';
import { archiveProjects } from '../../data/products';
---

<Layout
  title="Project Archive: Retired and Open-Source Work | RePass Cloud"
  exactTitle
  description="Retired and legacy RePass Cloud projects, including LunaVPN, OptechX and the original CurseDelete, kept for reference. Current software is on the Products page."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Archive</h1>
      <p class="lead">
        Retired projects, kept here for reference. They aren't maintained. For what we build and operate
        today, see <a href="/products/">Products</a>.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap">
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th scope="col">Project</th><th scope="col">About</th><th scope="col"><span class="sr-only">Link</span></th></tr></thead>
          <tbody>
            {archiveProjects.map((p) => (
              <tr>
                <th scope="row" style="color:var(--ink);font-size:1.02rem;white-space:nowrap">{p.name}</th>
                <td class="muted">
                  {p.description}
                  {p.note && <><br /><span class="small">{p.note}</span></>}
                </td>
                <td style="white-space:nowrap">
                  {p.githubUrl ? <a href={p.githubUrl} target="_blank" rel="noopener">GitHub ↗</a> : <a href="/products/cursedelete/">Current version</a>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small" style="margin-top:28px">All of our public repositories are on <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>.</p>
    </div>
  </section>
</Layout>
