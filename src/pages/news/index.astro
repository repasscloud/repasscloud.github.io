---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="News, Product Updates and Engineering Notes | RePass Cloud"
  exactTitle
  description="Company news, product updates and engineering notes from RePass Cloud on AI, Microsoft 365 identity automation, PowerShell and the software we ship."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>News and writing</h1>
      <p class="lead">
        Company news, product updates, and notes on the engineering problems behind the systems we build.
      </p>
      <p class="small" style="margin-top:16px"><a href="/rss.xml">Subscribe by RSS</a></p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="muted">Nothing published yet.</p>
      ) : (
        <ul class="news-list">
          {posts.map((post) => (
            <li>
              <FormattedDate date={post.data.pubDate} />
              <div>
                <a href={`/news/${post.id}/`}>{post.data.title}</a>
                <p>{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="tags" aria-label="Topics">
                    {post.data.tags.slice(0, 4).map((tag) => <li class="tag tag-neutral">{tag}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>
