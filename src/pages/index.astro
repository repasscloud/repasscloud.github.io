---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_DOMAIN } from '../consts';
import { products } from '../data/products';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homepageProducts = products.filter((p) => p.showOnHomepage);

const capabilities = [
  {
    icon: 'bi-diagram-3',
    title: 'Enterprise platform engineering',
    description:
      'Multi-tenant software, operational control planes, and internal systems designed to survive real enterprise complexity.',
    href: '/services/enterprise-platforms',
  },
  {
    icon: 'bi-cloud-arrow-up',
    title: 'Cloud tooling and governance',
    description:
      'Automation and decision-support tooling across Azure and AWS for cost, risk, compliance, and operational consistency.',
    href: '/services/cloud-tooling',
  },
  {
    icon: 'bi-microsoft',
    title: 'M365 identity automation',
    description:
      'Lifecycle automation across Entra ID and Microsoft 365 covering onboarding, offboarding, access, and audit evidence.',
    href: '/services/m365-automation',
  },
  {
    icon: 'bi-terminal',
    title: 'PowerShell delivery',
    description:
      'Production-grade modules and scripts that remove manual runbook work while preserving control, logging, and supportability.',
    href: '/services/powershell',
  },
];

const caseStudies = [
  {
    label: 'Enterprise identity',
    title: 'Microsoft 365 identity automation',
    description:
      'Rule-driven lifecycle automation across AU and NZ brands with approvals, mailbox changes, and policy-safe access flows.',
    outcome: '2,100 staff supported with zero daily manual IT intervention.',
    tags: ['Microsoft 365', 'Entra ID', 'PowerShell'],
  },
  {
    label: 'Finance operations',
    title: 'Workflow automation at retail scale',
    description:
      'End-to-end processing automation across approvals, provisioning, and reconciliation for a large multi-brand business.',
    outcome: 'Eliminated a 4 FTE manual burden.',
    tags: ['Oracle HCM', 'Workflow', 'Identity'],
  },
  {
    label: 'Cloud governance',
    title: 'FinOps tooling across multi-cloud',
    description:
      'Unified governance and realised-savings tracking across AWS, Azure, and GCP in one operational view.',
    outcome: 'Visibility across approximately $7M USD annual spend.',
    tags: ['AWS', 'Azure', 'GCP'],
  },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'RePass Cloud Pty Ltd',
  url: SITE_DOMAIN,
  logo: 'https://repasscloud.com/images/repass-cloud-logo.png',
  description: SITE_DESCRIPTION,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sydney',
    addressCountry: 'AU',
  },
  sameAs: [
    'https://github.com/repasscloud',
    'https://www.linkedin.com/company/repass-cloud',
    'https://twitter.com/repasscloud',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: SITE_DOMAIN,
};
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero-eyebrow"><i class="bi bi-stars"></i> Australian software company</div>
      <h1>RePass Cloud builds software products and engineering systems.</h1>
      <p class="hero-lead">
        We design, build, own, and operate software products, alongside enterprise engineering work
        across cloud automation, identity, and Microsoft 365.
      </p>
      <div class="hero-actions">
        <a href="/products" class="btn btn-primary btn-lg">Explore our products <i class="bi bi-arrow-right"></i></a>
        <a href="/about" class="btn btn-outline btn-lg">About RePass Cloud</a>
      </div>
      <div class="hero-trust">
        <div class="hero-trust-item"><i class="bi bi-geo-alt"></i> Built in Sydney, delivered globally</div>
        <div class="hero-trust-item"><i class="bi bi-shield-check"></i> Production-grade, audit-aware engineering</div>
        <div class="hero-trust-item"><i class="bi bi-box-seam"></i> Products we own and operate ourselves</div>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <div class="showcase-split">
        <div>
          <div class="section-label">Who we are</div>
          <h2>A software company, not a brochure agency.</h2>
          <p class="section-intro">
            RePass Cloud designs, builds, and operates software — from named products people can use
            directly, to serious enterprise systems delivered for organisations that need identity
            fidelity, governance, and long-term reliability.
          </p>
          <div class="hero-trust">
            <div class="hero-trust-item"><i class="bi bi-check2-circle"></i> Products we ship and support ourselves</div>
            <div class="hero-trust-item"><i class="bi bi-check2-circle"></i> Enterprise engineering depth behind the products</div>
            <div class="hero-trust-item"><i class="bi bi-check2-circle"></i> Built for real production constraints</div>
          </div>
        </div>
        <div class="showcase-panel">
          <div class="section-label">Engineering standard</div>
          <h3>The same standard across products and delivery work.</h3>
          <p class="text-muted">
            Whether it is a named product or a bespoke system, the same engineering discipline applies:
            correctness, security, and supportability first.
          </p>
          <div class="tech-stack">
            <span class="badge badge-primary">.NET</span>
            <span class="badge badge-secondary">Rust</span>
            <span class="badge badge-secondary">Azure / AWS</span>
            <span class="badge badge-secondary">Entra ID</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="text-center" style="margin-bottom:2rem;">
        <div class="section-label">Products</div>
        <h2>What we build and operate</h2>
      </div>
      <div class="grid-3">
        {homepageProducts.map((product) => (
          <div class="aethon-card">
            <div class="feature-icon">
              {product.iconImage ? (
                <img src={product.iconImage} alt="" width="24" height="24" loading="lazy" decoding="async" style="object-fit:contain;" />
              ) : (
                <i class={`bi ${product.icon}`}></i>
              )}
            </div>
            <h3>{product.name}</h3>
            <p class="text-muted" style="margin-top:0.4rem;">{product.tagline}</p>
            <div class="tech-stack" style="margin-top:0.7rem;">
              {product.tags.slice(0, 3).map((tag) => (
                <span class="badge badge-secondary">{tag}</span>
              ))}
            </div>
            <div style="margin-top:0.9rem;">
              <a
                href={product.href}
                class="btn btn-primary btn-sm"
                target={product.destination === 'external' ? '_blank' : undefined}
                rel={product.destination === 'external' ? 'noopener' : undefined}
              >
                {product.destination === 'external' ? (
                  <Fragment>Visit {product.name} <i class="bi bi-box-arrow-up-right"></i></Fragment>
                ) : (
                  <Fragment>View product <i class="bi bi-arrow-right"></i></Fragment>
                )}
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center" style="margin-top:1.5rem;">
        <a href="/products" class="btn btn-outline btn-sm">All products <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <div class="text-center" style="margin-bottom:2rem;">
        <div class="section-label">Capabilities</div>
        <h2>What we build for enterprise teams</h2>
      </div>
      <div class="grid-2">
        {capabilities.map((item) => (
          <a href={item.href} class="feature-card">
            <div class="feature-icon"><i class={`bi ${item.icon}`}></i></div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="text-center" style="margin-bottom:2rem;">
        <div class="section-label">Case studies</div>
        <h2>Proven in live environments</h2>
      </div>
      <div class="grid-3">
        {caseStudies.map((study) => (
          <div class="aethon-card">
            <div class="section-label">{study.label}</div>
            <h3>{study.title}</h3>
            <p class="text-sm text-muted" style="margin-top:0.5rem;">{study.description}</p>
            <p style="margin-top:0.65rem; font-weight:700;">{study.outcome}</p>
            <div class="tech-stack">
              {study.tags.map((tag) => (
                <span class="badge badge-secondary">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="text-center" style="margin-top:1.5rem;">
        <a href="/case-studies" class="btn btn-outline btn-sm">All case studies <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1rem; flex-wrap:wrap;">
        <div>
          <div class="section-label">News</div>
          <h2>Latest from RePass Cloud</h2>
        </div>
        <a href="/news" class="btn btn-outline btn-sm">All news <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="grid-3">
        {recentPosts.map((post) => (
          <a href={`/news/${post.id}/`} class="blog-card">
            <div class="blog-card-body">
              <div class="blog-card-meta"><FormattedDate date={post.data.pubDate} /></div>
              <div class="blog-card-title">{post.data.title}</div>
              <div class="blog-card-desc">{post.data.description}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
