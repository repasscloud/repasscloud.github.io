---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProductRows from '../components/ProductRows.astro';
import {
  BRAND_LOGO_PNG,
  COMPANY_ADDRESS_PARTS,
  COMPANY_LEGAL_NAME,
  CURSEDELETE_VERSION,
  GITHUB_URL,
  LINKEDIN_URL,
  SITE_DESCRIPTION,
  SITE_DOMAIN,
  SITE_TITLE,
  TWITTER_URL,
} from '../consts';
import { books, bookOne, formatReleaseDate, SERIES } from '../data/books';
import { capabilities, outcomes } from '../data/engineering';

const recentPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_DOMAIN}/#organization`,
  name: COMPANY_LEGAL_NAME,
  alternateName: SITE_TITLE,
  url: SITE_DOMAIN,
  logo: new URL(BRAND_LOGO_PNG, SITE_DOMAIN).href,
  description: SITE_DESCRIPTION,
  taxID: '74642243801',
  address: { '@type': 'PostalAddress', ...COMPANY_ADDRESS_PARTS },
  sameAs: [GITHUB_URL, LINKEDIN_URL, TWITTER_URL, SERIES.url],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: SITE_DOMAIN,
  publisher: { '@id': `${SITE_DOMAIN}/#organization` },
};
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <section class="home-hero">
    <div class="wrap">
      <div class="home-hero-copy">
        <h1>Software we build and run. Books on using AI well.</h1>
        <p class="lead">
          RePass Cloud is an Australian software company and publisher. We design, build and operate{' '}
          <strong>CurseDelete&nbsp;2</strong>, <strong>Cinturon360</strong> and <strong>Aethon&nbsp;Jobs</strong>,
          and we publish <strong>{SERIES.name}</strong>, a five-book series that starts with{' '}
          <em>{bookOne.title}</em>.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/products/">See our products</a>
          <a class="btn btn-quiet" href={`/publishing/${bookOne.slug}/`}>Pre-order Book 1</a>
        </div>
      </div>

      <div class="home-stage">
        <a class="home-cover" href={`/publishing/${bookOne.slug}/`}>
          {bookOne.cover && (
            <Image src={bookOne.cover} alt={`${bookOne.title}, Book 1 of the ${SERIES.name} series. Out ${formatReleaseDate(bookOne.releaseDate!)}.`} widths={[300, 450, 600]} sizes="(max-width: 600px) 220px, 300px" loading="eager" fetchpriority="high" />
          )}
        </a>
        <pre class="terminal home-term" aria-label="Example CurseDelete 2 dry run"><span class="dim"># CurseDelete 2, {CURSEDELETE_VERSION}</span>
<span class="prompt">$</span> cursdel ./old-build --dry-run
Workers:      auto -&gt; 10
Would delete: 4 files, 3 directories
<span class="ok">No files were modified.</span></pre>
      </div>
    </div>
  </section>

  <section class="section band" id="portfolio">
    <div class="wrap">
      <div class="sec-head">
        <h2>Two lines of work, one standard</h2>
        <p>Every product and every book is owned by RePass Cloud. We write it, ship it, and keep supporting it after launch.</p>
      </div>
      <div class="split">
        <div class="panel">
          <h3>Software</h3>
          <p>Products we design, build and operate ourselves.</p>
          <ProductRows />
          <p class="small" style="margin:18px 0 0"><a class="text-link" href="/products/">All products</a></p>
        </div>
        <div class="panel">
          <h3>Publishing</h3>
          <p>{SERIES.name}: a five-book path from first use to engineering.</p>
          <ol class="vol-list">
            {books.map((b) => (
              <li>
                <span class="vol-n" style={`--accent:${b.accent}`}>{b.number}</span>
                <span>
                  {b.page ? <a href={`/publishing/${b.slug}/`}>{b.title}</a> : <b>{b.title}</b>}
                  <span class="vol-stage">{b.stage}</span>
                </span>
                <span class={`vol-when${b.status !== 'planned' ? ' is-live' : ''}`}>{b.status === 'planned' ? 'Planned' : b.statusLabel.replace('Out ', '')}</span>
              </li>
            ))}
          </ol>
          <p class="small" style="margin:18px 0 0"><a class="text-link" href="/publishing/">About the series</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="engineering">
    <div class="wrap split-wide">
      <div>
        <h2 style="margin-bottom:20px">The engineering behind the products</h2>
        <p class="muted">The same team builds enterprise systems where identity, controls and audit evidence have to hold up in production. That work is what our products are built on.</p>
        <p><a class="text-link" href="/engineering/">How we work with enterprise teams</a></p>
      </div>
      <dl class="caps">
        {capabilities.map((c) => (
          <div><dt>{c.title}</dt><dd>{c.summary}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="sec-head">
        <h2>Selected engineering work</h2>
        <p>Client names are withheld. Figures come from the systems as delivered.</p>
      </div>
      <div class="outcomes">
        {outcomes.map((o) => (
          <article>
            <p class="ctx">{o.context}</p>
            <p class="big">{o.headline}</p>
            <p>{o.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="news">
    <div class="wrap">
      <div class="sec-head">
        <h2>News and writing</h2>
        <p><a class="text-link" href="/news/">All posts</a></p>
      </div>
      <ul class="news-list">
        {recentPosts.map((post) => (
          <li>
            <FormattedDate date={post.data.pubDate} />
            <div>
              <a href={`/news/${post.id}/`}>{post.data.title}</a>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    padding: 88px 0 96px;
    overflow: hidden;
  }

  .home-hero .wrap {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
  }

  .home-hero h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.5rem);
    max-width: 13ch;
  }

  .home-hero .lead {
    margin-top: 28px;
    max-width: 54ch;
  }

  .home-hero .lead strong {
    color: var(--ink);
    font-weight: 600;
  }

  .home-stage {
    position: relative;
    min-height: 500px;
  }

  .home-cover {
    position: absolute;
    top: 0;
    right: 6%;
    width: 300px;
    display: block;
    border-radius: 3px 6px 6px 3px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.05),
      0 30px 60px -22px rgba(10, 22, 51, 0.55);
  }

  .home-cover :global(img) {
    width: 100%;
    height: auto;
  }

  .home-term {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 340px;
    margin: 0;
    font-size: 0.8rem;
    box-shadow: 0 24px 50px -18px rgba(24, 20, 31, 0.6);
  }

  .vol-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .vol-list li {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 18px;
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .vol-n {
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
  }

  .vol-list a,
  .vol-list b {
    font-weight: 600;
    color: var(--ink);
  }

  .vol-list a:hover {
    color: var(--violet);
  }

  .vol-stage {
    margin-left: 6px;
    color: var(--ink-3);
    font-size: 0.9rem;
  }

  .vol-when {
    font-size: 0.88rem;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .vol-when.is-live {
    color: var(--magenta);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-cover {
      animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both 0.1s;
    }

    .home-term {
      animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both 0.35s;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (max-width: 960px) {
    .home-hero .wrap {
      grid-template-columns: 1fr;
    }

    .home-stage {
      max-width: 480px;
      min-height: 460px;
    }
  }

  @media (max-width: 600px) {
    .home-hero {
      padding: 56px 0 64px;
    }

    .home-stage {
      min-height: 400px;
    }

    .home-cover {
      width: 220px;
      right: 0;
    }

    .home-term {
      width: min(300px, 82%);
      padding: 14px 16px;
      font-size: 0.68rem;
      white-space: pre-wrap;
    }

    .vol-list li {
      grid-template-columns: 36px 1fr;
    }

    .vol-when {
      grid-column: 2;
    }
  }
</style>
