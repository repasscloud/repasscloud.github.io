# Cloudflare permanent redirects for URLs that have been public or indexed.
# Treat old URLs as a public API: when a page moves, add a rule here instead
# of deleting the old address. Specific rules must come before splats.
# Exact paths are listed with and without a trailing slash.

# Hugo-era tag pages
/tags/*  /news/  301

# /posts was renamed /news. One indexed URL had a typo in its slug.
/posts/2026-03-06-export-microsoft-365-mialboxes-powershell   /news/2026-03-06-export-microsoft-365-mailboxes-powershell/  301
/posts/2026-03-06-export-microsoft-365-mialboxes-powershell/  /news/2026-03-06-export-microsoft-365-mailboxes-powershell/  301
# Workers static assets apply splat rules before these exact ones for /posts/,
# so the misspelt slug is also caught after it lands on /news/.
/news/2026-03-06-export-microsoft-365-mialboxes-powershell   /news/2026-03-06-export-microsoft-365-mailboxes-powershell/  301
/news/2026-03-06-export-microsoft-365-mialboxes-powershell/  /news/2026-03-06-export-microsoft-365-mailboxes-powershell/  301
/posts   /news/  301
/posts/*  /news/:splat  301

# Old projects page is now the archive
